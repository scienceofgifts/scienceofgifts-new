---
import '../index.css';
import { contentRepository } from '../cms/contentRepository';
import {
  HeaderActiveSection,
  SHOP_EXTERNAL_URL,
  resolveEditorialHubHeaderLinks,
} from '../config/navigationConfig';
import EditorialFooter from '../components/EditorialFooter.astro';
import {
  HeaderSearchButtonIsland,
  HeaderSavedButtonIsland,
  MobileNavigationIsland,
  GlobalOverlaysIsland,
} from '../components/islands/AstroIslands';

import {
  DEFAULT_OG_IMAGE_URL,
  resolveCanonicalUrl,
  type ResolvedPageSeoMetadata,
} from '../utils/seoAndValidation';

export interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogType?: 'website' | 'article' | 'product';
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  noindex?: boolean;
  robots?: 'index, follow' | 'noindex, follow';
  seo?: ResolvedPageSeoMetadata;
  jsonLd?: Record<string, unknown>;
  activeSection?: HeaderActiveSection;
  pageBgClass?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  ogTitle,
  ogDescription,
  ogImage = DEFAULT_OG_IMAGE_URL,
  noindex = false,
  robots,
  seo,
  jsonLd,
  activeSection = 'home',
  pageBgClass = 'bg-[#FAF9F6]',
} = Astro.props;

const effectiveTitle = seo?.seoTitle ?? title;
const effectiveDescription = seo?.metaDescription ?? description;
const { canonicalUrl } = resolveCanonicalUrl(
  seo?.canonicalPath ?? canonicalPath,
  canonicalPath
);
const effectiveOgType = seo?.ogType ?? ogType;
const effectiveOgTitle = seo?.ogTitle ?? ogTitle ?? effectiveTitle;
const effectiveOgDescription =
  seo?.ogDescription ?? ogDescription ?? effectiveDescription;
const effectiveOgImage = seo?.ogImage ?? ogImage;
const effectiveNoindex = Boolean(seo?.noindex ?? noindex);
const effectiveRobots =
  seo?.robots ?? robots ?? (effectiveNoindex ? 'noindex, follow' : 'index, follow');

await contentRepository.ensureSyncedFromSanity();
const siteSettings = contentRepository.getSiteSettings();
const branding = siteSettings.branding;
const customLogoUrl = branding?.logoUrl;
const brandNameText = siteSettings.siteName || 'Science of Gifts';
const customLogoAlt = branding?.logoAlt || brandNameText;
const logoDesktopHeightPx = Math.min(
  56,
  Math.max(18, Math.round(branding?.logoDesktopHeight ?? 32))
);
const logoMobileHeightPx = Math.min(
  44,
  Math.max(16, Math.round(branding?.logoMobileHeight ?? 26))
);
const logoCompactHeightPx = Math.min(logoDesktopHeightPx, 36);
const headerBrandingStyle = customLogoUrl
  ? `--sog-logo-desktop-h:${logoDesktopHeightPx}px;--sog-logo-mobile-h:${logoMobileHeightPx}px;--sog-logo-compact-h:${logoCompactHeightPx}px;`
  : undefined;

const productsMap = contentRepository.getCatalogSnapshot().products;
const readyHubSlugs = contentRepository
  .getPublishedReadyEditorialHubs()
  .map((item) => item.hub.slug);
const editorialHubHeaderLinks = resolveEditorialHubHeaderLinks({
  readyHubSlugs,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{effectiveTitle}</title>
    <meta name="description" content={effectiveDescription} />
    <meta name="robots" content={effectiveRobots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content={brandNameText} />
    <meta property="og:title" content={effectiveOgTitle} />
    <meta property="og:description" content={effectiveOgDescription} />
    <meta property="og:type" content={effectiveOgType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={effectiveOgImage} />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={effectiveOgTitle} />
    <meta name="twitter:description" content={effectiveOgDescription} />
    <meta name="twitter:image" content={effectiveOgImage} />

    <!-- Editorial Google Fonts (Matches src/styles/site-theme.css) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..600&family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Lora:ital,wght@0,400..700;1,400..600&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..600&family=Playfair+Display:ital,wght@0,400..700;1,400..600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Source+Sans+3:ital,wght@0,400..700;1,400..600&display=swap"
      rel="stylesheet"
    />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body
    class={`${pageBgClass} text-[#24282B] antialiased selection:bg-[#E5F3EC] selection:text-[#1B3D5F] min-h-screen flex flex-col`}
  >
    <!-- =====================================================================
         COLLAPSIBLE STICKY EDITORIAL & DISCOVERY HEADER
         - Desktop Top of Page: Two-Row Header (Row 1: Wordmark, Search Field, Saved Gifts, Find a Gift; Row 2: Category Links)
         - Desktop Scrolled (>100px): Compact Single-Row Sticky Header (Wordmark, Category Links, Search Icon, Saved Gifts Icon, Find a Gift)
         - Mobile/Tablet (<1024px): Clean Single-Row Sticky Header (Wordmark on left, Search Icon + Menu Button on right)
        ===================================================================== -->
    <header
      id="site-header"
      data-scrolled="false"
      style={headerBrandingStyle}
      class="sticky top-0 z-30 h-[60px] lg:h-[113px] pointer-events-none"
    >
      <!-- STATE 1: TWO-ROW DESKTOP HEADER (Top of Page) + CLEAN SINGLE-ROW MOBILE HEADER -->
      <div
        data-header-bar="expanded"
        class="site-header-expanded bg-[#FAF9F6]/95 backdrop-blur-md border-b border-[#E3E1DB]"
      >
        <!-- ROW 1: Brand Wordmark / Logo, Prominent Search Field (Desktop), and Right Actions -->
        <div class="relative max-w-[1360px] mx-auto flex lg:grid lg:grid-cols-[1fr_minmax(340px,560px)_1fr] items-center justify-between gap-4 lg:gap-8 px-4 sm:px-8 lg:px-10 h-[60px] lg:h-[68px]">
          <!-- Left: Brand Logo (if published in Sanity Branding) or Complete Serif Wordmark Fallback -->
          <div class="flex items-center justify-start min-w-0">
            <a
              href="/"
              class={
                customLogoUrl
                  ? 'inline-flex items-center max-w-full min-w-0 hover:opacity-85 transition-opacity duration-150 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1B3D5F]'
                  : 'text-[1.35rem] sm:text-[1.55rem] lg:text-[1.65rem] font-serif font-semibold tracking-[-0.024em] leading-none text-[#24282B] hover:opacity-80 transition-opacity duration-150 whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1B3D5F]'
              }
            >
              {
                customLogoUrl ? (
                  <img
                    src={customLogoUrl}
                    alt={customLogoAlt}
                    width={branding.logoDimensions?.width}
                    height={branding.logoDimensions?.height}
                    data-site-logo="expanded"
                    class="site-brand-logo"
                    loading="eager"
                    decoding="async"
                  />
                ) : (
                  brandNameText
                )
              }
            </a>
          </div>

          <!-- Middle (Desktop): Prominent, Generously Sized Search Field -->
          <div class="hidden lg:flex items-center justify-center w-full">
            <HeaderSearchButtonIsland client:load variant="bar" />
          </div>

          <!-- Right: Saved Gifts & Find a Gift (Desktop Only) + Search & Menu (Mobile Only) -->
          <div class="flex items-center justify-end gap-2 lg:gap-5 shrink-0">
            <div class="hidden lg:flex items-center">
              <HeaderSavedButtonIsland client:idle variant="desktop" />
            </div>

            <a
              href="/gift-finder/"
              aria-current={activeSection === 'finder' ? 'page' : undefined}
              class={`hidden lg:inline-flex items-center gap-2 theme-btn-primary theme-button-text px-4 h-[38px] text-[0.75rem] font-semibold tracking-[0.01em] text-[#FFFFFF] bg-[#1B3D5F] rounded-[6px] hover:bg-[#28537D] transition-colors duration-150 whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F] ${
                activeSection === 'finder' ? 'ring-1 ring-[#28537D] ring-offset-2' : ''
              }`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.65"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="h-[15px] w-[15px] shrink-0"
              >
                <rect x="3" y="8" width="18" height="4" rx="1" />
                <path d="M12 8v13" />
                <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" />
                <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5" />
              </svg>
              <span>Find a Gift</span>
            </a>

            <MobileNavigationIsland client:load activeSection={activeSection} />
          </div>
        </div>

        <!-- ROW 2 (Desktop): Clean Sans-Serif Category Navigation Bar -->
        <div class="hidden lg:block border-t border-[#E3E1DB]/80">
          <nav
            aria-label="Primary Navigation"
            class="max-w-[1360px] mx-auto px-5 sm:px-8 lg:px-10 h-[44px] flex items-center justify-center gap-10 xl:gap-12"
          >
            <a
              href="/gift-guides/"
              aria-current={activeSection === 'guides' ? 'page' : undefined}
              class={`theme-nav-link h-full inline-flex items-center whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F] ${
                activeSection === 'guides' ? 'theme-nav-link-active' : ''
              }`}
            >
              Gift Guides
            </a>

            {
              editorialHubHeaderLinks.map((hubLink) => {
                const isCurrent = activeSection === hubLink.activeSection;
                return (
                  <a
                    href={hubLink.href}
                    aria-current={isCurrent ? 'page' : undefined}
                    class={`theme-nav-link h-full inline-flex items-center whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F] ${
                      isCurrent ? 'theme-nav-link-active' : ''
                    }`}
                  >
                    {hubLink.label}
                  </a>
                );
              })
            }

            <a
              href="/articles/"
              aria-current={activeSection === 'articles' ? 'page' : undefined}
              class={`theme-nav-link h-full inline-flex items-center whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F] ${
                activeSection === 'articles' ? 'theme-nav-link-active' : ''
              }`}
            >
              Stories
            </a>

            <a
              href={SHOP_EXTERNAL_URL}
              class="theme-nav-link h-full inline-flex items-center gap-1.5 whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F]"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.65"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="h-[14px] w-[14px] shrink-0 text-[#24282B] opacity-80 -translate-y-[0.5px]"
              >
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
                <path d="M3 6h18" />
                <path d="M16 10a4 4 0 0 1-8 0" />
              </svg>
              <span>Shop</span>
            </a>
          </nav>
        </div>
      </div>

      <!-- STATE 2: COMPACT SINGLE-ROW STICKY DESKTOP HEADER (Scrolled >100px) -->
      <div
        data-header-bar="compact"
        class="site-header-compact hidden lg:block absolute top-0 left-0 right-0 bg-[#FAF9F6]/95 backdrop-blur-md border-b border-[#E3E1DB] shadow-[0_4px_20px_-12px_rgba(17,17,17,0.08)]"
      >
        <div class="max-w-[1360px] mx-auto px-5 sm:px-8 lg:px-10 h-[62px] grid grid-cols-[1fr_auto_1fr] items-center gap-6">
          <!-- Left: Science of Gifts Logo or Wordmark -->
          <div class="flex items-center justify-start min-w-0">
            <a
              href="/"
              class={
                customLogoUrl
                  ? 'inline-flex items-center max-w-full min-w-0 hover:opacity-85 transition-opacity duration-150 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1B3D5F]'
                  : 'text-[1.45rem] font-serif font-semibold tracking-[-0.024em] leading-none text-[#24282B] hover:opacity-80 transition-opacity duration-150 whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1B3D5F]'
              }
            >
              {
                customLogoUrl ? (
                  <img
                    src={customLogoUrl}
                    alt={customLogoAlt}
                    width={branding.logoDimensions?.width}
                    height={branding.logoDimensions?.height}
                    data-site-logo="compact"
                    class="site-brand-logo-compact"
                    loading="eager"
                    decoding="async"
                  />
                ) : (
                  brandNameText
                )
              }
            </a>
          </div>

          <!-- Center: Main Navigation Links -->
          <nav
            aria-label="Sticky Primary Navigation"
            class="h-full flex items-center justify-center gap-8 xl:gap-10"
          >
            <a
              href="/gift-guides/"
              aria-current={activeSection === 'guides' ? 'page' : undefined}
              class={`theme-nav-link h-full inline-flex items-center whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F] ${
                activeSection === 'guides' ? 'theme-nav-link-active' : ''
              }`}
            >
              Gift Guides
            </a>

            {
              editorialHubHeaderLinks.map((hubLink) => {
                const isCurrent = activeSection === hubLink.activeSection;
                return (
                  <a
                    href={hubLink.href}
                    aria-current={isCurrent ? 'page' : undefined}
                    class={`theme-nav-link h-full inline-flex items-center whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F] ${
                      isCurrent ? 'theme-nav-link-active' : ''
                    }`}
                  >
                    {hubLink.label}
                  </a>
                );
              })
            }

            <a
              href="/articles/"
              aria-current={activeSection === 'articles' ? 'page' : undefined}
              class={`theme-nav-link h-full inline-flex items-center whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F] ${
                activeSection === 'articles' ? 'theme-nav-link-active' : ''
              }`}
            >
              Stories
            </a>

            <a
              href={SHOP_EXTERNAL_URL}
              class="theme-nav-link h-full inline-flex items-center gap-1.5 whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F]"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.65"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="h-[14px] w-[14px] shrink-0 text-[#24282B] opacity-80 -translate-y-[0.5px]"
              >
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
                <path d="M3 6h18" />
                <path d="M16 10a4 4 0 0 1-8 0" />
              </svg>
              <span>Shop</span>
            </a>
          </nav>

          <!-- Right: Search Icon, Saved Gifts Icon, and Black Find a Gift Button -->
          <div class="flex items-center justify-end gap-2.5 shrink-0">
            <HeaderSearchButtonIsland client:load variant="icon" />
            <HeaderSavedButtonIsland client:idle variant="compact-icon" />

            <a
              href="/gift-finder/"
              aria-current={activeSection === 'finder' ? 'page' : undefined}
              class={`inline-flex items-center gap-2 theme-btn-primary theme-button-text px-4 h-[36px] text-[0.75rem] font-semibold tracking-[0.01em] text-[#FFFFFF] bg-[#1B3D5F] rounded-[6px] hover:bg-[#28537D] transition-colors duration-150 whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F] ${
                activeSection === 'finder' ? 'ring-1 ring-[#28537D] ring-offset-2' : ''
              }`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.65"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="h-[14px] w-[14px] shrink-0"
              >
                <rect x="3" y="8" width="18" height="4" rx="1" />
                <path d="M12 8v13" />
                <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" />
                <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5" />
              </svg>
              <span>Find a Gift</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <script is:inline>
      (() => {
        const header = document.getElementById('site-header');
        if (!header) return;

        let isScrolled = false;
        let rafPending = false;

        const updateHeaderScrollState = () => {
          rafPending = false;
          const y = window.scrollY || window.pageYOffset || 0;
          if (!isScrolled && y > 100) {
            isScrolled = true;
            header.setAttribute('data-scrolled', 'true');
          } else if (isScrolled && y < 60) {
            isScrolled = false;
            header.setAttribute('data-scrolled', 'false');
          }
        };

        updateHeaderScrollState();
        window.addEventListener(
          'scroll',
          () => {
            if (!rafPending) {
              rafPending = true;
              window.requestAnimationFrame(updateHeaderScrollState);
            }
          },
          { passive: true }
        );
      })();
    </script>

    <!-- Main Page Content Slot -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Shared Multi-Column Editorial Publication Footer -->
    <EditorialFooter />

    <!-- Shared Overlays Island (Product Quick-View Modal, Saved List Drawer, Technical Spec Modal) -->
    <GlobalOverlaysIsland client:idle productsMap={productsMap} />
  </body>
</html>
