---
import '../index.css';
import { contentRepository } from '../cms/contentRepository';
import {
  HeaderActiveSection,
  SHOP_EXTERNAL_URL,
  resolveEditorialHubHeaderLinks,
} from '../config/navigationConfig';
import EditorialFooter from '../components/EditorialFooter.astro';
import {
  HeaderSearchButtonIsland,
  HeaderSavedButtonIsland,
  MobileNavigationIsland,
  GlobalOverlaysIsland,
} from '../components/islands/AstroIslands';

import {
  DEFAULT_OG_IMAGE_URL,
  resolveCanonicalUrl,
  type ResolvedPageSeoMetadata,
} from '../utils/seoAndValidation';

export interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogType?: 'website' | 'article' | 'product';
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  noindex?: boolean;
  robots?: 'index, follow' | 'noindex, follow';
  seo?: ResolvedPageSeoMetadata;
  jsonLd?: Record<string, unknown>;
  activeSection?: HeaderActiveSection;
  pageBgClass?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  ogTitle,
  ogDescription,
  ogImage = DEFAULT_OG_IMAGE_URL,
  noindex = false,
  robots,
  seo,
  jsonLd,
  activeSection = 'home',
  pageBgClass = 'bg-[#FAF9F6]',
} = Astro.props;

const effectiveTitle = seo?.seoTitle ?? title;
const effectiveDescription = seo?.metaDescription ?? description;
const { canonicalUrl } = resolveCanonicalUrl(
  seo?.canonicalPath ?? canonicalPath,
  canonicalPath
);
const effectiveOgType = seo?.ogType ?? ogType;
const effectiveOgTitle = seo?.ogTitle ?? ogTitle ?? effectiveTitle;
const effectiveOgDescription =
  seo?.ogDescription ?? ogDescription ?? effectiveDescription;
const effectiveOgImage = seo?.ogImage ?? ogImage;
const effectiveNoindex = Boolean(seo?.noindex ?? noindex);
const effectiveRobots =
  seo?.robots ?? robots ?? (effectiveNoindex ? 'noindex, follow' : 'index, follow');

const productsMap = contentRepository.getCatalogSnapshot().products;
const readyHubSlugs = contentRepository
  .getPublishedReadyEditorialHubs()
  .map((item) => item.hub.slug);
const editorialHubHeaderLinks = resolveEditorialHubHeaderLinks({
  readyHubSlugs,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{effectiveTitle}</title>
    <meta name="description" content={effectiveDescription} />
    <meta name="robots" content={effectiveRobots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="Science of Gifts" />
    <meta property="og:title" content={effectiveOgTitle} />
    <meta property="og:description" content={effectiveOgDescription} />
    <meta property="og:type" content={effectiveOgType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={effectiveOgImage} />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={effectiveOgTitle} />
    <meta name="twitter:description" content={effectiveOgDescription} />
    <meta name="twitter:image" content={effectiveOgImage} />

    <!-- Editorial Google Fonts (Matches src/styles/site-theme.css) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..600&family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Lora:ital,wght@0,400..700;1,400..600&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..600&family=Playfair+Display:ital,wght@0,400..700;1,400..600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Source+Sans+3:ital,wght@0,400..700;1,400..600&display=swap"
      rel="stylesheet"
    />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body
    class={`${pageBgClass} text-[#24282B] antialiased selection:bg-[#E5F3EC] selection:text-[#1B3D5F] min-h-screen flex flex-col`}
  >
    <!-- =====================================================================
         TOP NAVIGATION BAR (Calm Magazine Masthead)
         Group 1 (Left): Science of Gifts
         Group 2 (Center): Gift Guides | For Him | For Her | Stories | Shop
         Group 3 (Right): Search | Saved Gifts | Find a Gift
        ===================================================================== -->
    <header class="sticky top-0 z-30 bg-[#FAF9F6]/95 backdrop-blur-md border-b border-[#E3E1DB]">
      <div class="relative max-w-7xl mx-auto flex items-center justify-between gap-6 px-6 py-4">
        <!-- Group 1 (Left): Brand Wordmark -->
        <a
          href="/"
          class="text-2xl font-serif font-semibold tracking-tight text-[#24282B] whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F]"
        >
          Science of Gifts
        </a>

        <!-- Group 2 (Center): Editorial Navigation Links -->
        <nav
          aria-label="Primary Navigation"
          class="hidden lg:flex items-center justify-center gap-7 theme-nav-link"
        >
          <a
            href="/gift-guides/"
            aria-current={activeSection === 'guides' ? 'page' : undefined}
            class={`theme-nav-link hover:text-[#1B3D5F] hover:underline underline-offset-4 transition-colors whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F] ${
              activeSection === 'guides'
                ? 'theme-nav-link-active text-[#1B3D5F] font-semibold underline decoration-[#1B3D5F]/50'
                : 'text-[#24282B]'
            }`}
          >
            Gift Guides
          </a>

          {
            editorialHubHeaderLinks.map((hubLink) => {
              const isCurrent = activeSection === hubLink.activeSection;
              return (
                <a
                  href={hubLink.href}
                  aria-current={isCurrent ? 'page' : undefined}
                  class={`theme-nav-link hover:text-[#1B3D5F] hover:underline underline-offset-4 transition-colors whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F] ${
                    isCurrent
                      ? 'theme-nav-link-active text-[#1B3D5F] font-semibold underline decoration-[#1B3D5F]/50'
                      : 'text-[#24282B]'
                  }`}
                >
                  {hubLink.label}
                </a>
              );
            })
          }

          <a
            href="/articles/"
            aria-current={activeSection === 'articles' ? 'page' : undefined}
            class={`theme-nav-link hover:text-[#1B3D5F] hover:underline underline-offset-4 transition-colors whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F] ${
              activeSection === 'articles'
                ? 'theme-nav-link-active text-[#1B3D5F] font-semibold underline decoration-[#1B3D5F]/50'
                : 'text-[#24282B]'
            }`}
          >
            Stories
          </a>

          <a
            href={SHOP_EXTERNAL_URL}
            class="theme-nav-link inline-flex items-center gap-1.5 text-[#24282B] hover:text-[#1B3D5F] hover:underline underline-offset-4 transition-colors whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="h-[17px] w-[17px] shrink-0 text-[#1B3D5F]"
            >
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
              <path d="M3 6h18" />
              <path d="M16 10a4 4 0 0 1-8 0" />
            </svg>
            <span>Shop</span>
          </a>
        </nav>

        <!-- Group 3 (Right): Utilities (Search, Saved Gifts) & Primary CTA (Find a Gift) -->
        <div class="flex items-center gap-3.5 shrink-0">
          <div class="hidden lg:flex items-center gap-4">
            <HeaderSearchButtonIsland client:load />
            <HeaderSavedButtonIsland client:idle variant="desktop" />
          </div>

          <a
            href="/gift-finder/"
            aria-current={activeSection === 'finder' ? 'page' : undefined}
            class={`hidden lg:inline-flex items-center gap-2 theme-btn-primary theme-button-text px-4 py-2 text-xs font-semibold text-[#FFFFFF] bg-[#1B3D5F] rounded-lg hover:bg-[#28537D] transition-colors whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1B3D5F] ${
              activeSection === 'finder' ? 'ring-2 ring-[#28537D] ring-offset-2' : ''
            }`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="h-4 w-4 shrink-0"
            >
              <rect x="3" y="8" width="18" height="4" rx="1" />
              <path d="M12 8v13" />
              <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" />
              <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5" />
            </svg>
            <span>Find a Gift</span>
          </a>

          <MobileNavigationIsland client:load activeSection={activeSection} />
        </div>
      </div>
    </header>

    <!-- Main Page Content Slot -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Shared Multi-Column Editorial Publication Footer -->
    <EditorialFooter />

    <!-- Shared Overlays Island (Product Quick-View Modal, Saved List Drawer, Technical Spec Modal) -->
    <GlobalOverlaysIsland client:idle productsMap={productsMap} />
  </body>
</html>
