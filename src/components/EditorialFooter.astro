---
import {
  AFFILIATE_DISCLOSURE_CONFIG,
  EDITORIAL_FOOTER_COLUMNS,
} from '../config/navigationConfig';
import {
  FooterSavedActionsIsland,
  FooterSavedLinkIsland,
} from './islands/AstroIslands';

const currentYear = new Date().getFullYear();
---

<footer
  aria-label="Publication Footer"
  class="border-t border-[#E3E1DB] bg-[#FFFFFF] text-[#24282B]"
>
  <div class="mx-auto max-w-7xl px-6 py-14 lg:py-16">
    <!-- Top Multi-Column Publication Architecture -->
    <div class="grid grid-cols-1 gap-10 pb-12 lg:grid-cols-12 lg:gap-8 border-b border-[#E3E1DB]">
      <!-- Brand Identity & Publication Summary (4 columns on desktop) -->
      <div class="lg:col-span-4 space-y-4">
        <a
          href="/"
          class="inline-block font-serif text-2xl font-semibold tracking-tight text-[#24282B] hover:text-[#28537D] transition-colors"
        >
          Science of Gifts
        </a>
        <p class="theme-body-sm max-w-sm text-sm leading-relaxed text-[#636A6F]">
          An editorial gift publication and discovery platform combining behavioral research, recipient suitability analysis, and curated gift guides.
        </p>
        <div class="pt-1">
          <FooterSavedActionsIsland client:visible />
        </div>
      </div>

      <!-- Four Structured Editorial Columns (8 columns on desktop) -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:col-span-8">
        {
          EDITORIAL_FOOTER_COLUMNS.map((column) => (
            <nav aria-label={`${column.heading} Footer Navigation`} class="space-y-3">
              <h2 class="theme-info-label text-xs font-semibold uppercase tracking-wider text-[#24282B]">
                {column.heading}
              </h2>
              <ul class="space-y-2.5 text-sm">
                {column.links.map((link) => (
                  <li>
                    {link.isSavedDrawerTrigger ? (
                      <FooterSavedLinkIsland client:visible />
                    ) : (
                      <a
                        href={link.href}
                        class="theme-link text-sm text-[#24282B] transition-colors hover:text-[#28537D] hover:underline"
                      >
                        {link.label}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <!-- Bottom Disclosure & Dynamic Copyright Bar -->
    <div class="pt-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between text-xs text-[#636A6F]">
      <p class="theme-caption max-w-3xl leading-relaxed">
        {AFFILIATE_DISCLOSURE_CONFIG.shortInlineNotice}{' '}
        <a
          href={AFFILIATE_DISCLOSURE_CONFIG.disclosurePageHref}
          class="font-semibold text-[#28537D] underline underline-offset-2 hover:text-[#1B3D5F]"
        >
          Read our Affiliate Disclosure
        </a>
        .
      </p>
      <p class="theme-metadata shrink-0 tabular-nums text-[#636A6F]">
        © {currentYear} Science of Gifts. All rights reserved.
      </p>
    </div>
  </div>
</footer>
