---
import '../../styles/studio-scoped.css';
import { resolveSanityEnvironmentConfig } from '../../cms/studio/sanityCore';
import {
  isStudioDevelopmentEnvironmentAllowed,
  issueStudioEditorSessionCredentials,
} from '../../cms/studio/sanityStudioAuth';
import { OfficialSanityStudioApp } from '../../components/studio/OfficialSanityStudioApp';

const isDevStudioAllowed =
  import.meta.env.DEV && isStudioDevelopmentEnvironmentAllowed();
const envConfig = resolveSanityEnvironmentConfig();
const sessionCredentials = isDevStudioAllowed
  ? issueStudioEditorSessionCredentials()
  : null;
---

<!doctype html>
<html lang="en" class="sog-studio-html">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Science of Gifts — Official Sanity Studio</title>
    <meta
      name="description"
      content="Science of Gifts Official Sanity Studio and AI Product Authoring workspace for managing canonical products, gift guides, stories, discovery hubs, and AI writing profiles."
    />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="sog-studio-body">
    {
      isDevStudioAllowed && sessionCredentials ? (
        <OfficialSanityStudioApp
          client:load
          envConfig={envConfig}
          sessionCredentials={sessionCredentials}
        />
      ) : (
        <main
          style="max-width: 42rem; margin: 0 auto; padding: 6rem 1.5rem; text-align: center; font-family: system-ui, -apple-system, sans-serif; color: #0F172A;"
        >
          <h1 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 1rem;">
            Editorial Studio Restricted to Development Environment
          </h1>
          <p style="font-size: 0.875rem; color: #475569; line-height: 1.6;">
            The Science of Gifts Sanity Editorial Studio and its draft mutation
            APIs are disabled in public production builds to protect dataset
            security.
          </p>
        </main>
      )
    }
  </body>
</html>
