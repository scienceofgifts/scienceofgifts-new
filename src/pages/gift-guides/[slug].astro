---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contentRepository } from '../../cms/contentRepository';
import {
  buildGiftGuideJsonLd,
  resolvePageSeoMetadata,
} from '../../utils/seoAndValidation';
import { GiftGuideInteractiveIsland } from '../../components/islands/AstroIslands';
import type { GiftGuide } from '../../types/content';

export function getStaticPaths() {
  const guides = contentRepository.getAllGiftGuides();
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: GiftGuide;
}

const { guide } = Astro.props;
const catalog = contentRepository.getCatalogSnapshot();
const resolvedSeo = resolvePageSeoMetadata({
  onPageTitle: guide.title,
  subtitleOrSummary: guide.subtitle,
  seo: guide.seo,
  defaultCanonicalPath: `/gift-guides/${guide.slug}/`,
  defaultOgType: 'article',
  defaultOgImage: guide.heroImageUrl,
  contentType: 'guide',
  status: guide.status,
});
const guideJsonLd = buildGiftGuideJsonLd(guide, catalog);
---

<BaseLayout
  title={resolvedSeo.seoTitle}
  description={resolvedSeo.metaDescription}
  canonicalPath={resolvedSeo.canonicalPath}
  ogType={resolvedSeo.ogType}
  ogTitle={resolvedSeo.ogTitle}
  ogDescription={resolvedSeo.ogDescription}
  ogImage={resolvedSeo.ogImage}
  noindex={resolvedSeo.noindex}
  robots={resolvedSeo.robots}
  seo={resolvedSeo}
  jsonLd={guideJsonLd}
  activeSection="guides"
>
  <GiftGuideInteractiveIsland
    client:load
    guide={guide}
    catalog={catalog}
  />
</BaseLayout>
