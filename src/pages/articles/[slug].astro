---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contentRepository } from '../../cms/contentRepository';
import {
  buildArticleJsonLd,
  resolvePageSeoMetadata,
} from '../../utils/seoAndValidation';
import { ArticleInteractiveIsland } from '../../components/islands/AstroIslands';
import type { Article } from '../../types/content';

export function getStaticPaths() {
  const articles = contentRepository.getAllArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const catalog = contentRepository.getCatalogSnapshot();
const resolvedSeo = resolvePageSeoMetadata({
  onPageTitle: article.title,
  subtitleOrSummary: article.subtitle,
  seo: article.seo,
  defaultCanonicalPath: `/articles/${article.slug}/`,
  defaultOgType: 'article',
  defaultOgImage: article.heroImageUrl,
  contentType: 'article',
  status: article.status,
});
const articleJsonLd = buildArticleJsonLd(article, catalog);
---

<BaseLayout
  title={resolvedSeo.seoTitle}
  description={resolvedSeo.metaDescription}
  canonicalPath={resolvedSeo.canonicalPath}
  ogType={resolvedSeo.ogType}
  ogTitle={resolvedSeo.ogTitle}
  ogDescription={resolvedSeo.ogDescription}
  ogImage={resolvedSeo.ogImage}
  noindex={resolvedSeo.noindex}
  robots={resolvedSeo.robots}
  seo={resolvedSeo}
  jsonLd={articleJsonLd}
  activeSection="articles"
  pageBgClass="bg-[#FAF7F2]"
>
  <ArticleInteractiveIsland
    client:load
    article={article}
    catalog={catalog}
  />
</BaseLayout>
