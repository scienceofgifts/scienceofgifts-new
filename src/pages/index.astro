---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contentRepository } from '../cms/contentRepository';
import {
  buildWebsiteJsonLd,
  calculateArticleReadingTime,
} from '../utils/seoAndValidation';
import {
  HomeHeroSpotlightIsland,
  HomeDiscoveryAndFinderIsland,
} from '../components/islands/AstroIslands';

const guides = contentRepository.getAllGiftGuides();
const articles = contentRepository.getAllArticles();
const products = contentRepository.getAllProducts();
const catalog = contentRepository.getCatalogSnapshot();
const recipientSpotlights = contentRepository.getRecipientSpotlights();

const featuredGuide = guides[0];
const featuredGuideAuthor = contentRepository.getAuthorById(featuredGuide.authorId);
const featuredArticle = articles[0];
const featuredArticleAuthor = contentRepository.getAuthorById(featuredArticle.authorId);
const etiquetteArticle = articles[1] ?? articles[0];
const etiquetteAuthor = contentRepository.getAuthorById(etiquetteArticle.authorId);
const etiquetteReadMinutes = calculateArticleReadingTime(etiquetteArticle);
const heroSpotlightProduct =
  contentRepository.getProductById('prod_kyoto_matcha_bowl_03') ?? products[0];

const websiteJsonLd = buildWebsiteJsonLd();
---

<BaseLayout
  title="Science of Gifts — Editorial Gift Guides & Memorable Finds"
  description="Discover thoughtful gifts backed by behavioral psychology, tactile craftsmanship, and rigorous hands-on testing from Science of Gifts."
  canonicalPath="/"
  ogType="website"
  ogImage={featuredGuide.heroImageUrl}
  jsonLd={websiteJsonLd}
  activeSection="home"
>
  <div>
    <!-- ===============================================================
         SECTION 1: WARM MAGAZINE & STOREFRONT HERO SPREAD
         Expressive photography, emotional storytelling, shoppable spotlights
        =============================================================== -->
    <section class="pt-6 pb-14 md:pt-10 md:pb-20">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
          <!-- Left: Dominant Editorial Cover Feature (7 columns) -->
          <div class="lg:col-span-7 flex flex-col justify-between">
            <a
              href={`/gift-guides/${featuredGuide.slug}/`}
              class="block relative aspect-16/10 w-full rounded-3xl overflow-hidden bg-[#F3ECE1] cursor-pointer group mb-6"
            >
              <img
                src={featuredGuide.heroImageUrl}
                alt={featuredGuide.heroImageAlt}
                loading="eager"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1B3D5F]/75 via-[#1B3D5F]/20 to-transparent"></div>
              <div class="absolute bottom-6 left-6 right-6 text-white">
                <div class="text-xs uppercase tracking-widest font-semibold text-[#C3F3DF] mb-2">
                  Featured Gift Guide · {featuredGuide.category}
                </div>
                <p class="text-sm md:text-base font-medium text-white/95 max-w-xl">
                  Curated by editors, informed by human psychology, and organized across under-$25, $25–$75, and $75+ budgets.
                </p>
              </div>
            </a>

            <div class="space-y-4 px-1">
              <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#28537D]">
                <span>Cover Guide</span>
                <span aria-hidden="true">·</span>
                <span>By {featuredGuideAuthor?.name}</span>
                <span aria-hidden="true">·</span>
                <span>{featuredGuide.readTimeMinutes} min read</span>
              </div>

              <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-serif font-semibold text-[#1B3D5F] leading-[1.12] text-balance">
                <a
                  href={`/gift-guides/${featuredGuide.slug}/`}
                  class="text-left hover:text-[#28537D] transition-colors"
                >
                  {featuredGuide.title}
                </a>
              </h1>

              <p class="text-base md:text-lg text-[#28537D] leading-relaxed max-w-2xl">
                {featuredGuide.subtitle}
              </p>

              <div class="pt-2 flex flex-wrap items-center gap-3.5">
                <a
                  href={`/gift-guides/${featuredGuide.slug}/`}
                  class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#1B3D5F] text-[#FAF7F2] text-xs font-semibold hover:bg-[#28537D] transition-colors whitespace-nowrap shrink-0"
                >
                  <span>Read the Complete Gift Guide</span>
                  <span aria-hidden="true">→</span>
                </a>
                <a
                  href="#gift-finder"
                  class="px-6 py-3 rounded-full bg-[#EBF3FE] text-[#1B3D5F] text-xs font-semibold hover:bg-[#99BFF9]/40 transition-colors whitespace-nowrap shrink-0"
                >
                  Try the Interactive Gift Finder
                </a>
              </div>
            </div>
          </div>

          <!-- Right: Asymmetric Two-Card Magazine Stack (5 columns) -->
          <div class="lg:col-span-5 flex flex-col justify-between gap-6">
            <!-- Top Card: Gift of the Week Spotlight on Warm Mint Surface (Interactive Island) -->
            {
              heroSpotlightProduct && (
                <HomeHeroSpotlightIsland
                  client:visible
                  product={heroSpotlightProduct}
                />
              )
            }

            <!-- Bottom Card: Warm Butter-Tinted Etiquette Essay (Static HTML) -->
            <div class="p-6 md:p-7 rounded-3xl bg-[#FFF4D6] flex flex-col justify-between">
              <div class="space-y-2.5">
                <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#28537D]">
                  <span>Modern Etiquette</span>
                  <span aria-hidden="true">·</span>
                  <span>{etiquetteReadMinutes} min read</span>
                </div>

                <h2 class="text-xl md:text-2xl font-serif font-semibold text-[#1B3D5F] leading-snug">
                  <a
                    href={`/articles/${etiquetteArticle.slug}/`}
                    class="text-left hover:underline"
                  >
                    {etiquetteArticle.title}
                  </a>
                </h2>

                <p class="text-xs md:text-sm text-[#1B3D5F]/80 leading-relaxed">
                  {etiquetteArticle.subtitle}
                </p>
              </div>

              <div class="pt-4 mt-3 flex items-center justify-between text-xs">
                <span class="text-[#28537D]">
                  By {etiquetteAuthor?.name}
                </span>
                <a
                  href={`/articles/${etiquetteArticle.slug}/`}
                  class="inline-flex items-center gap-1 font-semibold text-[#1B3D5F] hover:text-[#28537D]"
                >
                  <span>Read the story</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===============================================================
         SECTIONS 2, 3 & 4: INTERACTIVE RECIPIENT SPOTLIGHTS, GIFT FINDER & UNDER-$50 EDIT
        =============================================================== -->
    <HomeDiscoveryAndFinderIsland
      client:load
      products={products}
      recipientSpotlights={recipientSpotlights}
    />

    <!-- ===============================================================
         SECTION 5: CURATED GIFT GUIDES (STATIC MAGAZINE FEATURE SPREADS)
        =============================================================== -->
    <section id="editorial-guides" class="py-16 md:py-20 scroll-mt-14">
      <div class="max-w-7xl mx-auto px-6 space-y-12">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <div class="text-xs font-semibold uppercase tracking-widest text-[#28537D] mb-1.5">
              Curated Gift Guides
            </div>
            <h2 class="text-2xl md:text-4xl font-serif font-semibold text-[#1B3D5F]">
              Handpicked Guides for Real People & Occasions
            </h2>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
          {
            guides.map((guide, idx) => {
              const author = catalog.authors[guide.authorId];
              const bgClass =
                idx === 0
                  ? 'bg-[#E8F8F0] lg:col-span-7'
                  : 'bg-[#F3ECE1] lg:col-span-5';

              return (
                <article
                  class={`${bgClass} rounded-3xl p-6 md:p-8 flex flex-col justify-between space-y-6`}
                >
                  <div class="space-y-5">
                    <a
                      href={`/gift-guides/${guide.slug}/`}
                      class="block aspect-16/9 w-full rounded-2xl overflow-hidden bg-white cursor-pointer group"
                    >
                      <img
                        src={guide.heroImageUrl}
                        alt={guide.heroImageAlt}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                    </a>

                    <div class="space-y-2.5">
                      <div class="flex items-center gap-2 text-xs font-semibold text-[#28537D]">
                        <span>{guide.category}</span>
                        <span aria-hidden="true">·</span>
                        <span>By {author?.name}</span>
                        <span aria-hidden="true">·</span>
                        <span>{guide.readTimeMinutes} min read</span>
                      </div>

                      <h3 class="text-2xl md:text-3xl font-serif font-semibold text-[#1B3D5F] leading-snug">
                        <a
                          href={`/gift-guides/${guide.slug}/`}
                          class="text-left hover:underline"
                        >
                          {guide.title}
                        </a>
                      </h3>

                      <p class="text-sm text-[#1B3D5F]/80 leading-relaxed">
                        {guide.subtitle}
                      </p>
                    </div>

                    <!-- Shoppable Quick Picks Preview Strip -->
                    <div class="pt-3 space-y-2.5">
                      <div class="text-xs font-semibold uppercase tracking-wider text-[#28537D]">
                        Inside This Guide:
                      </div>
                      <div class="space-y-2">
                        {guide.quickPicks.slice(0, 3).map((qp) => {
                          const prod = catalog.products[qp.productId];
                          if (!prod) return null;
                          return (
                            <a
                              href={`/products/${prod.slug}/`}
                              class="p-3 rounded-2xl bg-white/80 hover:bg-white transition-colors flex items-center justify-between gap-3 cursor-pointer"
                            >
                              <div class="flex items-center gap-3 min-w-0">
                                <div class="w-11 h-11 rounded-xl overflow-hidden shrink-0 bg-[#F3ECE1]">
                                  <img
                                    src={prod.images[0].url}
                                    alt={prod.images[0].alt}
                                    loading="lazy"
                                    decoding="async"
                                    class="w-full h-full object-cover"
                                  />
                                </div>
                                <div class="min-w-0">
                                  <div class="text-[11px] font-semibold text-[#28537D]">
                                    {qp.label}
                                  </div>
                                  <div class="text-xs font-serif font-semibold text-[#1B3D5F] truncate">
                                    {prod.title}
                                  </div>
                                </div>
                              </div>
                              <span class="text-xs font-semibold text-[#1B3D5F] tabular-nums shrink-0">
                                ${prod.price} {prod.currency}
                              </span>
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  </div>

                  <div class="pt-2 flex items-center justify-between">
                    <a
                      href={`/gift-guides/${guide.slug}/`}
                      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#1B3D5F] text-[#FAF7F2] text-xs font-semibold hover:bg-[#28537D] transition-colors"
                    >
                      <span>Read Full Guide</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- ===============================================================
         SECTION 6: EDITORIAL STORY FEATURE (DEEP BLUE #1B3D5F SPREAD)
        =============================================================== -->
    <section class="py-16 md:py-20 bg-[#1B3D5F] text-[#FAF7F2]">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-6 space-y-5">
            <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-[#C3F3DF]">
              <span>Featured Essay · {featuredArticle.category}</span>
            </div>

            <h2 class="text-3xl md:text-5xl font-serif font-semibold text-white leading-tight text-balance">
              <a
                href={`/articles/${featuredArticle.slug}/`}
                class="hover:underline"
              >
                {featuredArticle.title}
              </a>
            </h2>

            <p class="text-base md:text-lg text-[#99BFF9] leading-relaxed">
              {featuredArticle.subtitle}
            </p>

            <blockquote class="py-4 border-y border-white/15 text-lg font-serif italic text-[#C3F3DF]">
              “A truly great gift doesn’t ask the recipient to invent a brand-new personality. It takes a quiet ritual they already love and makes it feel cherished.”
            </blockquote>

            <div class="pt-2 flex flex-wrap items-center gap-4">
              <a
                href={`/articles/${featuredArticle.slug}/`}
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#C3F3DF] text-[#1B3D5F] text-xs font-semibold hover:bg-white transition-colors whitespace-nowrap shrink-0"
              >
                <span>Read the Full Story</span>
                <span aria-hidden="true">→</span>
              </a>
              <span class="text-xs text-[#99BFF9]">
                By {featuredArticleAuthor?.name} · Includes {featuredArticle.citationIds.length} psychology studies
              </span>
            </div>
          </div>

          <div class="lg:col-span-6">
            <a
              href={`/articles/${featuredArticle.slug}/`}
              class="block aspect-4/3 rounded-3xl overflow-hidden bg-[#28537D] cursor-pointer group"
            >
              <img
                src={featuredArticle.heroImageUrl}
                alt={featuredArticle.heroAlt}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
