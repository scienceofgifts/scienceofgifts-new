---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contentRepository } from '../../cms/contentRepository';
import {
  buildProductJsonLd,
  resolvePageSeoMetadata,
} from '../../utils/seoAndValidation';
import { ProductDetailActionsIsland } from '../../components/islands/AstroIslands';
import { EditorialProductProfile } from '../../components/product/EditorialProductProfile';
import type { Product, ResearchCitation } from '../../types/content';

export function getStaticPaths() {
  const products = contentRepository.getAllProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const primaryImage = product.images[0] ?? {
  id: 'fallback',
  url: '',
  fallbackColor: '#F6F4EF',
  alt: product.title,
  isSampleAsset: true,
};

const guideAppearances = contentRepository.getProductGuideAppearances(product.id);
const similarComparisons = contentRepository.getSimilarProductComparisons(product);
const directArticles = contentRepository.getArticlesFeaturingProduct(product.id);
const relatedArticles =
  directArticles.length > 0
    ? directArticles
    : contentRepository.getAllArticles().slice(0, 2);

const citationsMap = contentRepository.getCitationsMap();
const citations = (product.citationIds ?? [])
  .map((id) => citationsMap[id])
  .filter((c): c is ResearchCitation => Boolean(c));

const primaryParentGuide = contentRepository.resolvePrimaryGuideForProduct(product.id);
const productJsonLd = buildProductJsonLd(
  product,
  primaryParentGuide,
  guideAppearances.length > 0
);

const resolvedSeo = resolvePageSeoMetadata({
  onPageTitle: product.title,
  subtitleOrSummary: `${product.subtitle} ${product.giftVerdict?.editorialAssessment || product.whyToGiveIt}`,
  seo: product.seo,
  defaultCanonicalPath: `/products/${product.slug}/`,
  defaultOgType: 'product',
  defaultOgImage: primaryImage.url,
  contentType: 'product',
  vendor: product.vendor,
  product,
  status: product.status,
});
---

<BaseLayout
  title={resolvedSeo.seoTitle}
  description={resolvedSeo.metaDescription}
  canonicalPath={resolvedSeo.canonicalPath}
  ogType={resolvedSeo.ogType}
  ogTitle={resolvedSeo.ogTitle}
  ogDescription={resolvedSeo.ogDescription}
  ogImage={resolvedSeo.ogImage}
  noindex={resolvedSeo.noindex}
  robots={resolvedSeo.robots}
  seo={resolvedSeo}
  jsonLd={productJsonLd}
  activeSection="products"
>
  <EditorialProductProfile
    product={product}
    guideAppearances={guideAppearances}
    similarComparisons={similarComparisons}
    relatedArticles={relatedArticles}
    citations={citations}
  >
    <ProductDetailActionsIsland client:visible product={product} />
  </EditorialProductProfile>
</BaseLayout>
