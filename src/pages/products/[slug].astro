---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contentRepository } from '../../cms/contentRepository';
import { buildProductJsonLd } from '../../utils/seoAndValidation';
import { ProductDetailActionsIsland } from '../../components/islands/AstroIslands';
import type { Product } from '../../types/content';

export function getStaticPaths() {
  const products = contentRepository.getAllProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const primaryImage = product.images[0] ?? {
  id: 'fallback',
  url: '',
  fallbackColor: '#EBF3FE',
  alt: product.title,
};

const guidesFeaturingProduct = contentRepository.getGuidesFeaturingProduct(product.id);
const articlesFeaturingProduct = contentRepository.getArticlesFeaturingProduct(product.id);
const relatedProducts = contentRepository
  .getAllProducts()
  .filter(
    (candidate) =>
      candidate.id !== product.id &&
      (candidate.budgetTier === product.budgetTier ||
        candidate.recipients.some((r) => product.recipients.includes(r)))
  )
  .slice(0, 3);

const productJsonLd = buildProductJsonLd(product);

const RECIPIENT_LABELS: Record<string, string> = {
  partner: 'Partner',
  parent: 'Parents & In-Laws',
  friend: 'Close Friends',
  host: 'Dinner Hosts',
  kids: 'Kids & Family',
  coworker: 'Coworkers',
};

const OCCASION_LABELS: Record<string, string> = {
  birthday: 'Birthdays',
  housewarming: 'Housewarming',
  anniversary: 'Anniversary',
  'thank-you': 'Thank You & Host',
  holidays: 'Holidays',
  'just-because': 'Just Because',
};
const seoTitle =
  product.seo?.seoTitle ??
  `${product.title} by ${product.vendor} — Gift Review | Science of Gifts`;
const seoDescription =
  product.seo?.metaDescription ??
  `${product.subtitle} ${product.whyToGiveIt}`;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonicalPath={`/products/${product.slug}/`}
  ogType="website"
  ogImage={primaryImage.url}
  jsonLd={productJsonLd}
  activeSection="products"
>
  <div class="max-w-6xl mx-auto px-6 py-8 md:py-12 space-y-14">
    <!-- Breadcrumb Navigation -->
    <nav
      aria-label="Breadcrumb"
      class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-[#1B3D5F]/10 text-xs text-[#28537D]"
    >
      <ol class="flex items-center gap-2">
        <li>
          <a
            href="/"
            class="inline-flex items-center gap-1.5 font-semibold text-[#1B3D5F] hover:underline"
          >
            <span>← Home</span>
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/#gift-finder" class="hover:underline">
            Gift Catalog
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-[#1B3D5F] font-medium truncate max-w-xs">
          {product.title}
        </li>
      </ol>

      <div class="text-xs text-[#28537D] font-mono">
        Canonical ID: {product.id}
      </div>
    </nav>

    <!-- Primary Product Split: Photography & Editorial Rationale -->
    <article class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left Column: Product Photography -->
      <div class="lg:col-span-6 space-y-4">
        <div
          class="aspect-4/5 w-full rounded-3xl overflow-hidden bg-[#F3ECE1] shadow-xs"
          style={`background-color: ${primaryImage.fallbackColor || '#F3ECE1'}`}
        >
          <img
            src={primaryImage.url}
            alt={primaryImage.alt}
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
        {
          primaryImage.caption && (
            <p class="text-xs font-serif italic text-[#28537D] px-2">
              {primaryImage.caption}
            </p>
          )
        }
      </div>

      <!-- Right Column: Editorial Review, Price & Actions -->
      <div class="lg:col-span-6 space-y-6">
        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#28537D]">
            {
              product.calloutTag && (
                <>
                  <span class="text-[#1B3D5F]">{product.calloutTag}</span>
                  <span aria-hidden="true">·</span>
                </>
              )
            }
            <span>{product.productType}</span>
            <span aria-hidden="true">·</span>
            <span>{product.vendor}</span>
          </div>

          <h1 class="text-3xl md:text-4xl font-serif font-semibold text-[#1B3D5F] leading-tight">
            {product.title}
          </h1>

          <p class="text-base md:text-lg text-[#28537D] leading-relaxed">
            {product.subtitle}
          </p>
        </div>

        <!-- Commerce & Bookmark Action Card -->
        <div class="p-6 rounded-3xl bg-[#F3ECE1] space-y-4">
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <div>
              <div class="text-3xl font-semibold text-[#1B3D5F] tabular-nums">
                ${product.price}{' '}
                <span class="text-sm font-normal text-[#28537D]">
                  {product.currency}
                </span>
              </div>
              <div class="text-xs text-[#28537D] mt-0.5">
                Curated from {product.vendor} · Availability: In Stock
              </div>
            </div>
          </div>

          <ProductDetailActionsIsland client:visible product={product} />

          {
            product.isPlaceholderLink && (
              <p class="pt-2 border-t border-[#1B3D5F]/10 text-[11px] text-[#28537D] leading-relaxed">
                Editorial Preview Note: This canonical product record (<code>{product.id}</code>) uses a development placeholder merchant link (<code>{product.purchaseUrl}</code>).
              </p>
            )
          }
        </div>

        <!-- Why It Makes a Great Gift -->
        <div class="p-6 rounded-3xl bg-[#E8F8F0] space-y-2">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-[#1B3D5F]">
            Why It Makes a Great Gift
          </h2>
          <p class="text-sm md:text-base text-[#1B3D5F] leading-relaxed">
            {product.whyToGiveIt}
          </p>
        </div>

        <!-- Details & Presentation -->
        <div class="space-y-2 px-1">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-[#28537D]">
            Details, Craftsmanship & Presentation
          </h2>
          <p class="text-sm text-[#28537D] leading-relaxed">
            {product.detailsAndCare}
          </p>
        </div>

        <!-- Structured Gift Taxonomy -->
        <div class="pt-4 border-t border-[#1B3D5F]/10 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-[#28537D]">
          <div>
            <strong class="block text-[#1B3D5F] mb-1">Ideal Recipients</strong>
            <span>
              {product.recipients.map((r) => RECIPIENT_LABELS[r] || r).join(' · ')}
            </span>
          </div>
          <div>
            <strong class="block text-[#1B3D5F] mb-1">Best Occasions</strong>
            <span>
              {product.occasions.map((o) => OCCASION_LABELS[o] || o).join(' · ')}
            </span>
          </div>
          <div class="sm:col-span-2">
            <strong class="block text-[#1B3D5F] mb-1">Best For</strong>
            <span>{product.bestForSummary}</span>
          </div>
          <div class="sm:col-span-2">
            <strong class="block text-[#1B3D5F] mb-1">Interests & Rituals</strong>
            <span>{product.interests.join(' · ')}</span>
          </div>
        </div>
      </div>
    </article>

    <!-- Editorial Guides & Stories Featuring This Gift -->
    {
      (guidesFeaturingProduct.length > 0 || articlesFeaturingProduct.length > 0) && (
        <section
          aria-labelledby="heading-featured-in"
          class="pt-10 border-t border-[#1B3D5F]/12 space-y-6"
        >
          <div>
            <div class="text-xs font-semibold uppercase tracking-widest text-[#28537D] mb-1">
              Editorial Context
            </div>
            <h2
              id="heading-featured-in"
              class="text-2xl md:text-3xl font-serif font-semibold text-[#1B3D5F]"
            >
              Featured In These Gift Guides & Stories
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {guidesFeaturingProduct.map((guide) => (
              <article class="rounded-3xl bg-[#E8F8F0] p-6 flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                  <div class="text-xs font-semibold uppercase tracking-wider text-[#28537D]">
                    Gift Guide · {guide.category}
                  </div>
                  <h3 class="text-xl font-serif font-semibold text-[#1B3D5F]">
                    <a href={`/gift-guides/${guide.slug}/`} class="hover:underline">
                      {guide.title}
                    </a>
                  </h3>
                  <p class="text-xs text-[#1B3D5F]/80 leading-relaxed">
                    {guide.subtitle}
                  </p>
                </div>
                <a
                  href={`/gift-guides/${guide.slug}/`}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#1B3D5F] hover:text-[#28537D]"
                >
                  <span>Read Gift Guide</span>
                  <span aria-hidden="true">→</span>
                </a>
              </article>
            ))}

            {articlesFeaturingProduct.map((article) => (
              <article class="rounded-3xl bg-[#FFF4D6] p-6 flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                  <div class="text-xs font-semibold uppercase tracking-wider text-[#28537D]">
                    Editorial Essay · {article.category}
                  </div>
                  <h3 class="text-xl font-serif font-semibold text-[#1B3D5F]">
                    <a href={`/articles/${article.slug}/`} class="hover:underline">
                      {article.title}
                    </a>
                  </h3>
                  <p class="text-xs text-[#1B3D5F]/80 leading-relaxed">
                    {article.subtitle}
                  </p>
                </div>
                <a
                  href={`/articles/${article.slug}/`}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#1B3D5F] hover:text-[#28537D]"
                >
                  <span>Read Story</span>
                  <span aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <!-- Related Gifts in the Catalog -->
    {
      relatedProducts.length > 0 && (
        <section
          aria-labelledby="heading-related-products"
          class="pt-10 border-t border-[#1B3D5F]/12 space-y-6"
        >
          <div>
            <div class="text-xs font-semibold uppercase tracking-widest text-[#28537D] mb-1">
              More From the Catalog
            </div>
            <h2
              id="heading-related-products"
              class="text-2xl md:text-3xl font-serif font-semibold text-[#1B3D5F]"
            >
              Complementary Gift Ideas
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            {relatedProducts.map((relProd) => (
              <article class="rounded-3xl bg-white p-5 flex flex-col justify-between space-y-4 shadow-2xs">
                <div class="space-y-3">
                  <a
                    href={`/products/${relProd.slug}/`}
                    class="block aspect-4/3 rounded-2xl overflow-hidden bg-[#F3ECE1]"
                  >
                    <img
                      src={relProd.images[0]?.url}
                      alt={relProd.images[0]?.alt || relProd.title}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover"
                    />
                  </a>
                  <div class="text-xs text-[#28537D] font-medium">
                    {relProd.vendor} · ${relProd.price} {relProd.currency}
                  </div>
                  <h3 class="text-lg font-serif font-semibold text-[#1B3D5F] leading-snug">
                    <a href={`/products/${relProd.slug}/`} class="hover:underline">
                      {relProd.title}
                    </a>
                  </h3>
                  <p class="text-xs text-[#1B3D5F]/80 line-clamp-2">
                    {relProd.subtitle}
                  </p>
                </div>
                <a
                  href={`/products/${relProd.slug}/`}
                  class="text-xs font-semibold text-[#1B3D5F] hover:text-[#28537D]"
                >
                  View Product Details →
                </a>
              </article>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
