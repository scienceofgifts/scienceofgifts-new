# =============================================================================
# Science of Gifts — Environment Configuration Template (.env.example)
# =============================================================================
# Phase 1: Schemas & Sanity Studio Editing Interface.
# Note: The Astro website remains on its local catalog (`src/data/catalog.ts`)
# during Phase 1. Setting Studio variables below configures Sanity Studio
# without replacing `contentRepository` or activating Sanity in production.

# 1. Sanity Studio Configuration (Only Project ID & Dataset are needed for Studio)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
SANITY_STUDIO_API_VERSION=2025-02-01

# 2. Server-Side Astro Build & Repository Connection (Reserved for Phase 2)
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=2025-02-01

# 3. Server-Side Sanity Content Lake Mutations (Required to save drafts to Sanity)
# Create in sanity.io/manage -> Project -> API -> Tokens -> Add API token (Role: Editor)
SANITY_API_WRITE_TOKEN=

# 4. Draft Previews & Optional Server Read Token (Optional — Reserved for Phase 2)
# Public datasets do NOT require a read token for published reads.
# SANITY_USE_PREVIEW_DRAFTS defaults to false and is parsed strictly as a boolean.
SANITY_USE_PREVIEW_DRAFTS=false
# SANITY_API_READ_TOKEN=
